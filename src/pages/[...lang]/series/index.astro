---
import Layout from "../../../layouts/Layout.astro";
import { api } from "../../../lib/api";

export const prerender = true;
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'fr' } }
  ];
}

const { lang: paramLang } = Astro.params;
const lang = paramLang === 'fr' ? 'fr' : 'en';

const SITE_URL = 'https://cloud.nivekaa.com';
const currentPath = Astro.url.pathname.replace(/^\/fr/, '') || '/series';

const response = await api.getArticles({ limit: 1000, lang });
const articles = response.items || [];

// Series are just articles that share the same `serie.slug` — there is no
// separate "series" entity/table, this is derived purely from article data.
const seriesMap = new Map();
articles.forEach((article: any) => {
    const s = article.serie;
    if (!s?.slug) return;
    if (!seriesMap.has(s.slug)) {
        seriesMap.set(s.slug, { slug: s.slug, name: s.name || s.slug, description: s.description || '', count: 0 });
    }
    seriesMap.get(s.slug).count += 1;
});
const seriesList = Array.from(seriesMap.values()).sort((a: any, b: any) => a.name.localeCompare(b.name));

const seriesHref = (slug: string) =>
    lang === 'fr' ? `/fr/series/${encodeURIComponent(slug)}` : `/series/${encodeURIComponent(slug)}`;
const homeHref = lang === 'fr' ? '/fr' : '/';
---

<Layout
    title={lang === 'fr' ? "Séries — CloudNive" : "Series — CloudNive"}
    description={lang === 'fr'
        ? "Des guides en plusieurs parties, à suivre du début à la fin."
        : "Multi-part guides, to follow from start to finish."}
    lang={lang}
    hreflangEn={`${SITE_URL}${currentPath}`}
    hreflangFr={`${SITE_URL}/fr${currentPath}`}
>
    <div class="max-w-3xl mx-auto px-6">
        <div style="padding-top:40px; padding-bottom:32px; border-bottom:1px solid var(--bg-border);">
            <a href={homeHref} style="font-size:13px; color:var(--text-dim); text-decoration:none;">
                &larr; {lang === 'fr' ? "Retour à l'accueil" : 'Back to home'}
            </a>
            <h1 style="margin-top:16px; font-family:'Inter',sans-serif; font-weight:600; font-size:28px; letter-spacing:-0.02em; color:var(--text-primary);">
                {lang === 'fr' ? 'Séries' : 'Series'}
            </h1>
            <p style="margin-top:8px; font-size:14px; color:var(--text-secondary); max-width:36rem;">
                {lang === 'fr'
                    ? 'Des guides en plusieurs parties, à suivre du début à la fin.'
                    : 'Multi-part guides, to follow from start to finish.'}
            </p>
        </div>

        {
            seriesList.length > 0 ? (
                <div style="padding:16px 0;">
                    {seriesList.map((s: any, i: number) => (
                        <a
                            href={seriesHref(s.slug)}
                            class="group"
                            style={`display:flex; align-items:flex-start; gap:20px; padding:24px 0; text-decoration:none; ${i < seriesList.length - 1 ? 'border-bottom:1px solid var(--bg-border);' : ''}`}
                        >
                            <div style="width:44px; height:44px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; background:rgba(75,86,148,0.1); color:#4B5694;">
                                <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="4.5" rx="1"></rect><rect x="4" y="10" width="16" height="4.5" rx="1"></rect><rect x="4" y="16" width="16" height="4.5" rx="1"></rect></svg>
                            </div>
                            <div style="flex:1; min-width:0;">
                                <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                                    <span style="font-family:'JetBrains Mono',monospace; font-size:11px; text-transform:uppercase; letter-spacing:0.06em; color:#4B5694;">
                                        {lang === 'fr' ? 'Série' : 'Series'}
                                    </span>
                                    <span style="color:var(--bg-border);">·</span>
                                    <span style="font-size:12px; color:var(--text-dim);">
                                        {s.count} {lang === 'fr' ? (s.count > 1 ? 'parties' : 'partie') : (s.count > 1 ? 'parts' : 'part')}
                                    </span>
                                </div>
                                <h3 class="group-hover:underline" style="font-size:17px; font-weight:600; line-height:1.3; color:var(--text-primary); text-underline-offset:2px;">
                                    {s.name}
                                </h3>
                                {s.description && (
                                    <p style="margin-top:4px; font-size:13px; line-height:1.5; color:var(--text-secondary);">
                                        {s.description}
                                    </p>
                                )}
                            </div>
                            <span style="color:var(--text-dim); flex-shrink:0; margin-top:4px;">&rarr;</span>
                        </a>
                    ))}
                </div>
            ) : (
                <div style="padding:64px 0; text-align:center;">
                    <p style="font-family:'Inter',sans-serif; color:var(--text-secondary); font-size:15px;">
                        {lang === 'fr' ? 'Aucune série publiée pour le moment.' : 'No series published yet.'}
                    </p>
                </div>
            )
        }
    </div>
</Layout>
