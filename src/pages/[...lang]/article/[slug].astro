---
import Layout from "../../../layouts/Layout.astro";
import { api } from "../../../lib/api";
import MarkdownRenderer from "../../../components/MarkdownRenderer.jsx";
import PublicAuthorCard from "../../../components/PublicAuthorCard.jsx";
import CoverImage from "../../../components/CoverImage.jsx";
import TableOfContents from "../../../components/TableOfContents.jsx";
import { DEFAULT_AUTHOR } from "../../../config/author";

// Active le mode statique (SSG)
export const prerender = true;

const SITE_URL = 'https://cloud.nivekaa.com';

export async function getStaticPaths() {
    const SITE_URL = 'https://cloud.nivekaa.com';
    const dataEn = await api.getArticles({ limit: 1000, lang: 'en' });
    const dataFr = await api.getArticles({ limit: 1000, lang: 'fr' });

    const articlesEn = Array.isArray(dataEn) ? dataEn : dataEn.items || [];
    const articlesFr = Array.isArray(dataFr) ? dataFr : dataFr.items || [];

    const paths: any[] = [];

    // The list endpoint only returns metadata — fetch each full article
    // individually so the `content` body is available on the page.
    await Promise.all(
        articlesEn.map(async (meta: any) => {
            try {
                const article = await api.getArticle(meta.slug);
                paths.push({
                    params: { lang: undefined, slug: article.slug },
                    props: {
                        article,
                        lang: 'en',
                        hreflangEn: `${SITE_URL}/article/${article.slug}`,
                        hreflangFr: article.translationAvailable ? `${SITE_URL}/fr/article/${article.slug}` : undefined,
                        siblings: articlesEn,
                    }
                });
            } catch { /* skip articles that fail to load */ }
        })
    );

    await Promise.all(
        articlesFr.map(async (meta: any) => {
            try {
                const article = await api.getArticle(meta.slug, 'fr');
                paths.push({
                    params: { lang: 'fr', slug: article.slug },
                    props: {
                        article,
                        lang: 'fr',
                        hreflangEn: article.translationAvailable ? `${SITE_URL}/article/${article.slug}` : undefined,
                        hreflangFr: `${SITE_URL}/fr/article/${article.slug}`,
                        siblings: articlesFr,
                    }
                });
            } catch { /* skip articles that fail to load */ }
        })
    );

    return paths;
}

const { article, lang, hreflangEn, hreflangFr, siblings = [] }: any = Astro.props;

// Use article author or default author
const author = article.author || DEFAULT_AUTHOR;

// Calculate reading time (assuming 200 words per minute)
const content = article.content || article.contentMarkdown;
const wordCount = content?.split(/\s+/).length || 0;
const readingTime = Math.ceil(wordCount / 200);

// Format date
const formatDate = (dateStr: string) => {
    const date = new Date(dateStr);
    return date.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', {
        year: "numeric",
        month: "long",
        day: "numeric",
    });
};
const siteUrl = Astro.site || SITE_URL;
const articleUrl = new URL(Astro.url.pathname, siteUrl);

// Related content: prefer same category, fall back to most recent others.
const others = siblings.filter((a: any) => a.slug !== article.slug);
const sameCategory = others.filter((a: any) => a.category === article.category);
const rest = others.filter((a: any) => a.category !== article.category);
const related = [...sameCategory, ...rest].slice(0, 2);

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: article.title,
    description: article.description,
    image: article.cover ? new URL(article.cover, siteUrl) : undefined,
    datePublished: article.date,
    dateModified: article.lastUpdated || article.date,
    author: {
        "@type": "Person",
        name: author.name,
        jobTitle: author.role,
        image: author.avatar,
    },
    publisher: {
        "@type": "Organization",
        name: "CloudNive",
        logo: {
            "@type": "ImageObject",
            url: new URL("/favicon.svg", siteUrl),
        },
    },
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": articleUrl,
    },
};
---

<Layout
    title={`${article.title}`}
    description={article.description}
    image={article.cover}
    type="article"
    lang={lang}
    hreflangEn={hreflangEn}
    hreflangFr={hreflangFr}
>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <div class="max-w-5xl mx-auto px-6">
      <div class="lg:flex lg:gap-16">

        <div class="lg:flex-1 min-w-0" style="max-width: 48rem;">

        <!-- Header -->
        <div style="padding-top:40px; padding-bottom:24px;">
            <span style="font-family:'JetBrains Mono',monospace; text-transform:uppercase; letter-spacing:0.06em; font-size:11px; color:var(--green-dark);">
                {article.category}
            </span>
            <h1 style="margin-top:12px; font-family:'Inter',sans-serif; font-weight:700; font-size:clamp(28px,4vw,40px); line-height:1.15; letter-spacing:-0.02em; color:var(--text-primary);">
                {article.title}
            </h1>
            <div class="flex items-center gap-3" style="margin-top:24px;">
                <img
                    src={author.avatar}
                    alt={author.name}
                    class="rounded-full"
                    style="width:36px; height:36px; object-fit:cover;"
                />
                <div>
                    <p style="margin:0; font-size:14px; font-weight:500; color:var(--text-primary);">{author.name}</p>
                    <p style="margin:0; font-size:13px; color:var(--text-dim);">
                        {formatDate(article.date)} · {readingTime} {lang === 'fr' ? 'min de lecture' : 'min read'}
                    </p>
                </div>
            </div>
        </div>

        <!-- Cover image -->
        <CoverImage
            client:load
            cover={article.cover}
            title={article.title}
        />

        <!-- Tags -->
        {
            article.tags && article.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-6">
                    {article.tags.map((tag: any) => (
                        <span class="game-tag">#{tag}</span>
                    ))}
                </div>
            )
        }

        <!-- Body -->
        <article class="prose max-w-none" style="padding-top:16px; padding-bottom:16px;">
            <MarkdownRenderer client:load content={content} />
        </article>

        <!-- Author box -->
        <PublicAuthorCard client:load author={author} />

        </div>

        <!-- Sidebar: Table of Contents (hidden on mobile) -->
        <aside class="hidden lg:block shrink-0" style="width:220px; padding-top:40px;">
            <TableOfContents client:load content={content} lang={lang} />
        </aside>

      </div>

        <!-- Related content -->
        {
            related.length > 0 && (
                <section style="border-top:1px solid var(--bg-border); padding:48px 0 64px;">
                    <p style="font-family:'JetBrains Mono',monospace; text-transform:uppercase; letter-spacing:0.1em; font-size:11px; color:var(--text-dim); margin-bottom:20px;">
                        {lang === 'fr' ? 'Contenu associé' : 'Related content'}
                    </p>
                    <div class="grid sm:grid-cols-2 gap-5">
                        {related.map((rel: any) => (
                            <a
                                href={`/article/${rel.slug}`}
                                class="group block no-underline"
                                style={`background: var(--bg-surface); border: 1px solid var(--bg-border); border-radius: 12px; overflow: hidden;`}
                            >
                                <div style="aspect-ratio: 16/10; overflow: hidden; background: var(--bg-panel);">
                                    <img
                                        src={rel.cover || `/api/cover/${rel.slug}.svg`}
                                        alt={rel.title}
                                        class="w-full h-full object-cover"
                                        loading="lazy"
                                        onerror={`this.onerror=null; this.src='/api/cover/${rel.slug}.svg';`}
                                    />
                                </div>
                                <div style="padding: 20px;">
                                    <span style={`font-family:'JetBrains Mono',monospace; font-size:11px; text-transform:uppercase; letter-spacing:0.06em; color:var(--green-dark);`}>
                                        {rel.category}
                                    </span>
                                    <h3 class="group-hover:underline" style="margin-top:8px; font-family:'Inter',sans-serif; font-weight:600; font-size:15px; color:var(--text-primary);">
                                        {rel.title}
                                    </h3>
                                </div>
                            </a>
                        ))}
                    </div>
                </section>
            )
        }
    </div>
</Layout>
