---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.jsx";
import NewsletterForm from "../../components/NewsletterForm.jsx";
import { api } from "../../lib/api";
import { getCategories } from "../../utils/api.js";

export const prerender = true;
export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'fr' } }
  ];
}

const { lang: paramLang } = Astro.params;
const lang = paramLang === 'fr' ? 'fr' : 'en';

const response = await api.getArticles({ limit: 100, lang });
const allArticles = response.items || [];
const validCategories: string[] = await getCategories();

// Sort by date desc
allArticles.sort(
	(a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

// Group into per-category blocks (up to 3 most recent articles each),
// only categories that actually have published articles are shown.
const categoryGroups = validCategories
	.map((cat: string) => ({
		name: cat,
		articles: allArticles.filter((a: any) => a.category === cat).slice(0, 3),
	}))
	.filter((group: any) => group.articles.length > 0);

const siteUrl = Astro.site || "https://cloud.nivekaa.com";
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	url: siteUrl,
	name: "CloudNive Blog",
	description: lang === 'fr' 
		? "Expertise technique sur le Cloud, le DevOps et le Développement Logiciel."
		: "Technical expertise on Cloud, DevOps and Software Engineering.",
	potentialAction: {
		"@type": "SearchAction",
		target: `${siteUrl}${lang === 'fr' ? '/fr' : ''}/articles?q={search_term_string}`,
		"query-input": "required name=search_term_string",
	},
};
---

<Layout
	title={lang === 'fr' ? "CloudNive - Blog Technique Cloud & DevOps" : "CloudNive - Cloud & DevOps Engineering Blog"}
	description={lang === 'fr' 
		? "Expertise technique sur le Cloud, le DevOps, et le Développement Web. Tutoriels, articles de fond et partage d'expérience."
		: "Technical expertise on Cloud, DevOps, and Web Development. Tutorials, deep dives and experience sharing."}
	lang={lang}
	hreflangEn={`${siteUrl}`}
	hreflangFr={`${siteUrl}/fr`}
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<!-- ===== HERO ===== -->
	<section class="max-w-5xl mx-auto px-6" style="padding-top: 64px; padding-bottom: 56px;">
		<p style="font-family:'JetBrains Mono',monospace; font-size:12px; text-transform:uppercase; letter-spacing:0.16em; color:var(--green-dark); margin-bottom:16px;">
			{lang === 'fr' ? 'Blog technique' : 'Technical blog'}
		</p>
		<h1 style="font-family:'Inter',sans-serif; font-weight:600; font-size:clamp(28px,5vw,54px); line-height:1.05; letter-spacing:-0.02em; color:var(--text-primary); max-width:42rem; margin:0;">
			{lang === 'fr'
				? "Cloud, infrastructure & ingénierie logicielle, expliqués simplement."
				: "Cloud, infrastructure & software engineering, explained simply."}
		</h1>
		<p style="margin-top:20px; font-size:16px; color:var(--text-secondary); max-width:36rem; line-height:1.7; font-family:'Inter',sans-serif;">
			{lang === 'fr'
				? "Tutoriels, guides et retours d'expérience sur le Cloud AWS/Azure, Terraform, Kubernetes et le développement logiciel moderne."
				: "Tutorials, guides, and experience sharing on AWS/Azure Cloud, Terraform, Kubernetes, and modern software engineering."}
		</p>
	</section>

	<!-- ===== CATEGORY BLOCKS ===== -->
	{
		categoryGroups.map((group: any) => (
			<section class="max-w-5xl mx-auto px-6 pb-16">
				<div class="flex items-baseline justify-between mb-6">
					<h2 style="font-family:'Inter',sans-serif; font-weight:600; font-size:20px; color:var(--text-primary); margin:0;">
						{group.name}
					</h2>
					<a
						href={lang === 'fr' ? `/fr/category/${encodeURIComponent(group.name)}` : `/category/${encodeURIComponent(group.name)}`}
						style="font-family:'Inter',sans-serif; font-size:13px; font-weight:500; color:var(--text-primary); text-decoration:none;"
						class="hover:underline"
					>
						{lang === 'fr' ? 'Voir tout →' : 'View all →'}
					</a>
				</div>
				<div class="grid sm:grid-cols-3 gap-5">
					{group.articles.map((article: any) => (
						<ArticleCard client:load article={article} />
					))}
				</div>
			</section>
		))
	}

	<!-- ===== NEWSLETTER ===== -->
	<section style="border-top:1px solid var(--bg-border); background:var(--bg-panel);">
		<div class="max-w-5xl mx-auto px-6 py-14">
			<NewsletterForm client:load lang={lang} />
		</div>
	</section>
</Layout>
