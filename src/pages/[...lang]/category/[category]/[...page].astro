---
import Layout from "../../../../layouts/Layout.astro";
import ArticleListRow from "../../../../components/ArticleListRow.jsx";
import Pagination from "../../../../components/Pagination.astro";
import { api } from "../../../../lib/api";
import { getCategories } from "../../../../utils/api";

export async function getStaticPaths({ paginate }: any) {
    const categories = await getCategories();

    // Fetch articles for both languages
    const responseEn = await api.getArticles({ limit: 1000, lang: 'en' });
    const responseFr = await api.getArticles({ limit: 1000, lang: 'fr' });

    let articlesEn = responseEn.items || [];
    let articlesFr = responseFr.items || [];

    const sortFn = (a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime();
    articlesEn.sort(sortFn);
    articlesFr.sort(sortFn);

    const enPaths = categories.flatMap((category) => {
        const filteredArticles = articlesEn.filter((article: any) => article.category === category);
        return paginate(filteredArticles, {
            params: { lang: undefined, category },
            pageSize: 24,
        });
    });

    const frPaths = categories.flatMap((category) => {
        const filteredArticles = articlesFr.filter((article: any) => article.category === category);
        return paginate(filteredArticles, {
            params: { lang: 'fr', category },
            pageSize: 24,
        });
    });

    return [...enPaths, ...frPaths];
}

export const prerender = true;

const { page } = Astro.props as any;
const { category, lang: paramLang }: any = Astro.params;
const lang = paramLang === 'fr' ? 'fr' : 'en';
const categories: string[] = await getCategories();

const SITE_URL = 'https://cloud.nivekaa.com';
const currentPath = Astro.url.pathname.replace(/^\/fr/, '') || `/category/${category}`;

const categoryHref = (cat: string) =>
    lang === 'fr' ? `/fr/category/${encodeURIComponent(cat)}` : `/category/${encodeURIComponent(cat)}`;
const allArticlesHref = lang === 'fr' ? '/fr/articles' : '/articles';
---

<Layout
    title={lang === 'fr' ? `Articles - ${category}` : `Articles - ${category}`}
    lang={lang}
    hreflangEn={`${SITE_URL}${currentPath}`}
    hreflangFr={`${SITE_URL}/fr${currentPath}`}
>
    <div class="max-w-3xl mx-auto px-6">

        <div style="padding-top:40px; padding-bottom:32px; border-bottom:1px solid var(--bg-border);">
            <h1 style="font-family:'Inter',sans-serif; font-weight:600; font-size:28px; letter-spacing:-0.02em; color:var(--text-primary); margin:0;">
                {category}
            </h1>
            <div class="flex flex-wrap gap-1.5" style="margin-top:24px;">
                <a
                    href={allArticlesHref}
                    class="text-[12px]"
                    style="padding:4px 10px; border-radius:4px; background:var(--bg-panel); color:var(--text-secondary); text-decoration:none;"
                >
                    {lang === 'fr' ? 'Tous' : 'All'}
                </a>
                {categories.map((cat: string) => (
                    cat === category ? (
                        <span
                            class="text-[12px] font-medium"
                            style="padding:4px 10px; border-radius:4px; background:var(--green-dark); color:var(--bg-deep);"
                        >
                            {cat}
                        </span>
                    ) : (
                        <a
                            href={categoryHref(cat)}
                            class="text-[12px]"
                            style="padding:4px 10px; border-radius:4px; background:var(--bg-panel); color:var(--text-secondary); text-decoration:none;"
                        >
                            {cat}
                        </a>
                    )
                ))}
            </div>
        </div>

        {
            page.data.length > 0 ? (
                <div style="padding-top:8px;">
                    {page.data.map((article: any) => (
                        <ArticleListRow client:load article={article} lang={lang} />
                    ))}
                </div>
            ) : (
                <div class="text-center" style="padding:64px 0;">
                    <p style="font-family:'Inter',sans-serif; color:var(--text-secondary); font-size:15px;">
                        {lang === 'fr' ? 'Aucun article trouvé dans cette catégorie.' : 'No articles found in this category.'}
                    </p>
                    <a
                        href={allArticlesHref}
                        class="btn btn--secondary mt-6 inline-block"
                    >
                        {lang === 'fr' ? 'Voir tous les articles' : 'View all articles'}
                    </a>
                </div>
            )
        }

        <Pagination page={page} lang={lang} />
    </div>
</Layout>
