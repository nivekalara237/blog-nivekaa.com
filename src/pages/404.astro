---
import Layout from "../layouts/Layout.astro";

// Astro's static build only recognizes a root-level src/pages/404.astro as
// the site-wide fallback for unmatched routes — it cannot receive URL params,
// so the FR/EN copy below is switched client-side based on the visited path.
---

<Layout
    title="404 - Page Not Found"
    description="The requested page does not exist."
    lang="en"
>
    <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 relative overflow-hidden">
        <div class="absolute inset-0 z-0 pointer-events-none" style="background-image: radial-gradient(var(--bg-border) 1px, transparent 1px); background-size: 30px 30px; opacity: 0.1;"></div>

        <div class="relative z-10 w-full max-w-2xl">
            <div
                style="background:var(--bg-surface); border:1px solid var(--bg-border); box-shadow: 0 4px 16px rgba(0,0,0,0.06);"
                class="text-left overflow-hidden rounded-xl"
            >
                <div
                    class="flex items-center gap-2 px-4 py-3"
                    style="background:var(--bg-panel); border-bottom:1px solid var(--bg-border);"
                >
                    <span style="width:10px;height:10px;background:#FF5F56;border:2px solid #FF5F56;display:inline-block;border-radius:999px;"></span>
                    <span style="width:10px;height:10px;background:#FFBB2C;border:2px solid #FFBB2C;display:inline-block;border-radius:999px;"></span>
                    <span style="width:10px;height:10px;background:var(--green-light);border:2px solid var(--green-light);display:inline-block;border-radius:999px;"></span>
                    <span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--text-dim);margin-left:8px;">
                        cloud@nivekaa ~ error
                    </span>
                </div>

                <div class="p-6 md:p-8" style="font-family:'JetBrains Mono',monospace; font-size:14px; line-height:1.8;">
                    <div class="mb-4">
                        <span style="color:var(--green-light); font-weight:bold;">$</span>
                        <span style="color:var(--text-primary); margin-left: 8px;" id="nf-path">curl https://cloud.nivekaa.com/...</span>
                    </div>

                    <div style="color:#FF5F56; font-weight:bold; margin-bottom: 8px;">
                        &gt; HTTP/1.1 404 Not Found
                    </div>

                    <div style="color:var(--text-secondary); margin-bottom: 24px;">
                        <span style="color:var(--yellow-dark);">Error:</span>
                        <span data-lang="en">The requested page does not exist.</span>
                        <span data-lang="fr" hidden>La page demandée n'existe pas.</span>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-4 mt-6">
                        <a href="/" class="btn btn--gold" style="font-size: 13px;">
                            <span data-lang="en">Back to home</span>
                            <span data-lang="fr" hidden>Retour à l'accueil</span>
                        </a>
                        <a href="/articles" class="btn btn--secondary" style="font-size: 13px;">
                            <span data-lang="en">View articles</span>
                            <span data-lang="fr" hidden>Voir les articles</span>
                        </a>
                    </div>

                    <div class="mt-8 flex items-center gap-2">
                        <span style="color:var(--green-light); font-weight:bold;">$</span>
                        <span style="display:inline-block;width:8px;height:15px;background:var(--green-light);animation:blink 1.1s step-end infinite;vertical-align:middle;margin-left:2px;"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script is:inline>
    (function () {
        var isFr = location.pathname === '/fr' || location.pathname.indexOf('/fr/') === 0;
        var pathEl = document.getElementById('nf-path');
        if (pathEl) pathEl.textContent = 'curl https://cloud.nivekaa.com' + location.pathname;
        if (!isFr) return;
        document.documentElement.lang = 'fr';
        document.querySelectorAll('[data-lang="fr"]').forEach(function (el) { el.hidden = false; });
        document.querySelectorAll('[data-lang="en"]').forEach(function (el) { el.hidden = true; });
        var homeLink = document.querySelector('a[href="/"]');
        if (homeLink) homeLink.setAttribute('href', '/fr');
        var articlesLink = document.querySelector('a[href="/articles"]');
        if (articlesLink) articlesLink.setAttribute('href', '/fr/articles');
    })();
</script>

<style>
    @keyframes blink {
        50% {
            opacity: 0;
        }
    }
</style>
